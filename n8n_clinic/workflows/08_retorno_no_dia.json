      "id": "67da28dc-0f5a-5953-b130-611903bdf9e2",
      "name": "Cada lead",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        780,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j = $json;\nconst nome = (j.nome_lead || '').trim().split(/\\s+/)[0] || '';\nconst consulta = 'retorno';\nconst system = `Você é a assistente virtual da ${j.nome_clinica}. Escreva UMA única mensagem de WhatsApp para ${nome || 'o paciente'}, que está na época de fazer o retorno/acompanhamento.\n\nRegras:\n- No máximo 2 frases curtas, português do Brasil, tom acolhedor e natural.\n- Diga que a equipe lembrou dele(a) e pergunte se quer marcar o ${consulta}. Use o histórico para ser específica (procedimento: ${j.procedimento_interesse || 'não informado'}).\n- No máximo 1 emoji. Sem markdown. Não prometa resultados. Responda apenas com o texto da mensagem.\n${j.sobre_clinica ? '\\nInformações da clínica:\\n' + j.sobre_clinica : ''}`;\n\nreturn { json: { ...j, system_prompt: system, mensagem: 'Escreva a mensagem de retorno agora.', chat: `${j.whatsapp_lead}@c.us` } };\n"
      },
      "id": "d02bbeca-a818-5fec-8b42-574d8d70952e",
      "name": "Preparar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
