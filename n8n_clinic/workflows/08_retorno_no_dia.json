{
  "name": "08 - Retorno no dia previsto",
  "nodes": [
    {
      "parameters": {
        "content": "## 08 — Retorno\nDe hora em hora, 9h–17h (SP). Leads em `retornar_3_meses/6_meses/1_ano` com `data_prevista_retorno` vencida recebem uma mensagem de retorno (IA) e voltam para `conversando`. Substitui o job pg_cron removido na migration 027.",
        "width": 600,
        "height": 210,
        "color": 4
      },
      "id": "27ffbaf4-0a37-53e3-b319-e912ed50efd8",
      "name": "Nota 0",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -380
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 0 9-17 * * *"
            }
          ]
        }
      },
