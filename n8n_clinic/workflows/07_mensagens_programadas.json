        0
      ],
      "credentials": {
        "supabaseApi": {
          "id": "",
          "name": "Supabase (service_role)"
        }
      }
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "7ea23a32-7a6a-5d20-b726-19b14ad72ec3",
      "name": "Cada lead",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        780,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j = $json;\nreturn { json: { ...j, texto: j.mensagem, chat: `${j.whatsapp_lead}@c.us` } };"
      },
      "id": "b9417df5-54b2-5070-bf0d-ba7445b274d3",
      "name": "Preparar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        190
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "82b9275c-6076-595e-b8fb-d1a15b070ded",
              "leftValue": "={{ $('Preparar').item.json.texto }}",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "ca2b7ae9-1540-553a-9053-03743cfb1e47",
      "name": "Tem texto?",
