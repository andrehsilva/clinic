    {
      "parameters": {
        "amount": "={{ Math.min(Math.max(Math.ceil(String($('Preparar').item.json.texto).length / 20), 1), 5) }}",
        "unit": "seconds"
      },
      "id": "5c625e35-6c8e-59bd-8c30-345966e8a63d",
      "name": "Pausa",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
