        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ session: $('Preparar').item.json.waha_session, chatId: $('Preparar').item.json.chat, text: $('Preparar').item.json.texto }) }}",
        "options": {}
      },
      "id": "2866864a-6e76-51b0-a154-b861f68b1adb",
      "name": "Enviar",
