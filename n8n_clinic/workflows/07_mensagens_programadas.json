      "position": [
        1820,
        190
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.waha_url }}/api/startTyping",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ session: $('Preparar').item.json.waha_session, chatId: $('Preparar').item.json.chat }) }}",
        "options": {}
      },
      "id": "174e3a2c-8c19-5365-9dae-28d3925ae7c8",
      "name": "Digitando",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2080,
        190
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "WAHA X-Api-Key"
        }
      },
      "onError": "continueRegularOutput"
