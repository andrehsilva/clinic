        "url": "={{ $('Config').first().json.supabase_url }}/rest/v1/rpc/n8n_marcar_lembrete",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_lead: $('Preparar').item.json.lead_id }) }}",
        "options": {}
      },
      "id": "91550312-3b2e-551e-a3c3-38648130c857",
      "name": "Marcar lembrete",
